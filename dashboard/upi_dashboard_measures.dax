Total Transactions = COUNTROWS(fact_transactions)

Total Transaction Value = SUM(fact_transactions[amount])

Success Rate =
DIVIDE(
    CALCULATE(COUNTROWS(fact_transactions), fact_transactions[status] = "SUCCESS"),
    COUNTROWS(fact_transactions)
)

Failure Rate =
DIVIDE(
    CALCULATE(COUNTROWS(fact_transactions), fact_transactions[status] = "FAILED"),
    COUNTROWS(fact_transactions)
)

Failed Transactions =
CALCULATE(COUNTROWS(fact_transactions), fact_transactions[status] = "FAILED")

Pending Transactions =
CALCULATE(COUNTROWS(fact_transactions), fact_transactions[status] = "PENDING")

Avg Transaction Value = AVERAGE(fact_transactions[amount])

Total Value by Zone =
SUMX(
    VALUES(dim_regions[zone]),
    CALCULATE(SUM(fact_transactions[amount]))
)

Transactions by Hour =
CALCULATE(COUNTROWS(fact_transactions), ALL(dim_date))

MoM Transaction Growth % =
VAR CurrentMonth = [Total Transactions]
VAR PreviousMonth =
    CALCULATE(
        [Total Transactions],
        DATEADD(dim_date[date], -1, MONTH)
    )
RETURN
    DIVIDE(CurrentMonth - PreviousMonth, PreviousMonth)

Failure Rate by Reason =
DIVIDE(
    CALCULATE(COUNTROWS(fact_transactions), fact_transactions[status] = "FAILED"),
    COUNTROWS(fact_transactions)
)

Status Distribution % =
DIVIDE(
    COUNTROWS(fact_transactions),
    CALCULATE(COUNTROWS(fact_transactions), ALL(fact_transactions[status]))
)

Transaction Value by Merchant Category =
SUMX(
    VALUES(dim_merchants[merchant_category]),
    CALCULATE(SUM(fact_transactions[amount]))
)
